# Copy to .env and fill in. Never commit the real .env.

# Postgres (Neon or Cloud SQL). For Neon: the connection string it gives you,
# including ?sslmode=require. For Cloud SQL via the Auth Proxy (unix socket):
# postgres://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT_ID:REGION:INSTANCE
DATABASE_URL=

# 'true' for Neon (requires SSL). 'false' for Cloud SQL's unix-socket path.
PGSSL=false

PORT=8080

# Firebase Admin service account, as a single-line JSON string.
# Get it from: Firebase Console -> Project Settings -> Service Accounts ->
# "Generate new private key". This is a real credential — never commit it,
# never paste it into chat. On Render, set it directly as an environment
# variable in the dashboard, pasting the entire downloaded JSON file's
# contents as one value.
FIREBASE_SERVICE_ACCOUNT=
