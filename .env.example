# Copy to .env and fill in. Never commit the real .env.

# Postgres Cloud SQL. Via the Cloud SQL Auth Proxy (unix socket) this looks like:
# postgres://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# Over TCP (e.g. local dev via the proxy's TCP mode) it's a normal
# postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# 'true' only if your connection method needs TLS (usually not needed for
# the Cloud SQL Auth Proxy / unix socket path above).
PGSSL=false

PORT=8080
